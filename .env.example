# Copy to .env and paste your funded OpenAI API key after the equals sign.
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1
STT_MODEL=gpt-4o-transcribe
# V2 bounded audio verification (independent from GPT-Live captions).
RECOGNITION_MODEL=gpt-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
# Local challenge demo. Do not expose this unauthenticated server publicly.
# V2: LiveKit Cloud project credentials (server only).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional access code. Leave empty to call without a code from local networks below.
SAWT_ACCESS_CODE=
# Comma-separated LAN CIDRs allowed to start calls without a code. Empty = loopback only.
SAWT_CODE_FREE_NETWORKS=

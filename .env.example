# Copy to .env and paste your funded OpenAI API key after the equals sign.
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1
STT_MODEL=gpt-4o-transcribe
# V2 bounded audio verification (independent from GPT-Live captions).
RECOGNITION_MODEL=gpt-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
# V2: one identity for live voice, exact readback and recovery. TTS_VOICE is V1-only.
SAWT_VOICE=marin
# One bounded acoustic retry only when critical recognition details disagree.
# Legacy recovery model retires 2027-02-26; revalidate its replacement before then.
RECOGNITION_RECOVERY_MODEL=gpt-4o-transcribe
# Local challenge demo. Do not expose this unauthenticated server publicly.
# V2: LiveKit Cloud project credentials (server only).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional access code. Leave empty to call without a code from local networks below.
SAWT_ACCESS_CODE=
# Comma-separated LAN CIDRs allowed to start calls without a code. Empty = loopback only.
SAWT_CODE_FREE_NETWORKS=
# Cloud only. Leave DATABASE_URL empty for local SQLite development.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
SAWT_AGENT_NAME=sawt-v2
SAWT_RUNTIME_DIR=
SAWT_PUBLIC_URL=
SAWT_DEMO_PASSWORD=
SAWT_DEMO_SECRET=

# Shared application call budget (separate from provider quotas).
SAWT_MAX_ACTIVE_CALLS=4
SAWT_MAX_CALLS_PER_HOUR=120
